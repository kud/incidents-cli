{
  "name": "@kud/incidents-cli",
  "version": "0.3.0",
  "description": "Which of the services you depend on are declaring trouble right now: vendor status pages in one terminal view.",
  "type": "module",
  "bin": {
    "incidents": "dist/bin/incidents.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx bin/incidents.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test 'test/**/*.test.ts' 'test/**/*.test.tsx'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "status",
    "statuspage",
    "incidents",
    "outage",
    "cli",
    "tui",
    "terminal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kud/incidents-cli"
  },
  "homepage": "https://kud.io/projects/incidents-cli",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kud/ink-ui": "0.44.1",
    "chalk": "5.6.2",
    "commander": "14.0.0",
    "ink": "7.1.0",
    "js-yaml": "4.3.2",
    "react": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.3.1",
    "@types/react": "19.2.17",
    "eslint": "10.14.0",
    "ink-testing-library": "4.0.0",
    "prettier": "3.10.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
